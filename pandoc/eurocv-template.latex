% ---- Section style (Euro look) ----
\titleformat{\section}
  {\large\bfseries\color{euoblue}}
  {}{0em}
  {}
  [\vspace{-4pt}\textcolor{rulecol}{\rule{\linewidth}{0.6pt}}\vspace{2pt}]

\titleformat{\subsection}
  {\normalsize\bfseries}
  {}{0em}{}

\titlespacing{\section}{0pt}{10pt}{4pt}
\titlespacing{\subsection}{0pt}{6pt}{2pt}

% ---- Custom list style ----
\setlist[itemize]{
  leftmargin=1.2em,
  itemsep=1pt,
  topsep=2pt,
  parsep=0pt
}

% ---- Euro header command ----
% Usage: \cvheader{Name}{Title}{Phone}{Email}{Address}{LinkedIn}{GitHub}{PhotoPath}
\newcommand{\cvheader}[8]{%
  \begin{minipage}[t]{0.72\linewidth}
    {\LARGE\bfseries\color{euoblue} #1}\\[4pt]
    {\large\color{euogray} #2}\\[8pt]
    \begin{tabular}{@{}ll@{\hspace{1.5em}}ll@{}}
      \faPhone\ & #3 & \faEnvelope\ & \href{mailto:#4}{#4} \\[2pt]
      \faMapMarker*\ & #5 & \faLinkedin\ & \href{https://#6}{#6} \\[2pt]
      \faGithub\ & \href{https://#7}{#7} & & \\
    \end{tabular}
  \end{minipage}%
  \hfill
  \begin{minipage}[t]{0.22\linewidth}
    \raggedleft
    \IfFileExists{#8}{%
      \includegraphics[width=2.8cm,height=3.6cm,keepaspectratio]{#8}%
    }{}
  \end{minipage}
  \vspace{6pt}
  \textcolor{rulecol}{\rule{\linewidth}{1.2pt}}
  \vspace{4pt}
}

% ---- Entry command ----
% Usage: \cventry{Period}{Role}{Company}{Description}
\newcommand{\cventry}[4]{%
  \begin{tabularx}{\linewidth}{@{}p{2.6cm}X@{}}
    \small\color{euogray}#1 &
    \textbf{#2} \newline
    \textit{\small #3} \newline
    \small #4
  \end{tabularx}
  \vspace{2pt}
}

% ---- Education entry ----
% Usage: \cvedu{Period}{Degree}{Institution}{Details}
\newcommand{\cvedu}[4]{\cventry{#1}{#2}{#3}{#4}}

% ---- Skill row ----
% Usage: \cvskill{Category}{Items}
\newcommand{\cvskill}[2]{%
  \begin{tabularx}{\linewidth}{@{}p{3cm}X@{}}
    \textbf{#1} & #2
  \end{tabularx}
  \vspace{1pt}
}

% ---- Language row ----
% Usage: \cvlang{Language}{Level}{Note}
\newcommand{\cvlang}[3]{%
  \begin{tabularx}{\linewidth}{@{}p{3cm}p{3cm}X@{}}
    \textbf{#1} & #2 & \small\color{euogray}#3
  \end{tabularx}
  \vspace{1pt}
}

